  <data name="Exhibit_Tutankhamun_Title" xml:space="preserve"><value>Golden Mask of Tutankhamun</value></data>
  <data name="Exhibit_Tutankhamun_Desc" xml:space="preserve"><value>Death mask of the 18th-dynasty ancient Egyptian pharaoh, crafted from solid gold, lapis lazuli, and obsidian.</value></data>
  <data name="Exhibit_Tutankhamun_Track" xml:space="preserve"><value>Track 2: Treasures of Eternity</value></data>
