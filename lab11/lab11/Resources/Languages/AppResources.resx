  <data name="Exhibit_WingedVictory_Desc" xml:space="preserve"><value>Monumental Hellenistic sculpture honoring the goddess Nike and a naval triumph, dynamic movement in white marble.</value></data>
  <data name="Exhibit_WingedVictory_Track" xml:space="preserve"><value>Track 4: Winds of Triumph</value></data>
