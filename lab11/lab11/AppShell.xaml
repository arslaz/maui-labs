<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="lab11.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:lab11"
    xmlns:services="clr-namespace:lab11.Services"
    Shell.NavBarIsVisible="False"
    FlowDirection="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=CurrentFlowDirection}"
    Title="Smart Museum Audio Guide">

    <ShellContent
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>
