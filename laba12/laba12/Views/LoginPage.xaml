<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:laba12.ViewModels"
             xmlns:conv="clr-namespace:laba12.Converters"
             x:Class="laba12.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0F172A">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToInvertedConverter x:Key="InvertedBoolConverter" />
            <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="iOS" Value="0,44,0,0" />
            <On Platform="Android" Value="0,12,0,0" />
            <On Platform="Default" Value="0,0,0,0" />
        </OnPlatform>
    </ContentPage.Padding>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="{OnPlatform Android='16,24', iOS='24,32', Default='20,28'}" MaximumWidthRequest="500" HorizontalOptions="Center">
                
                <!-- Header / Logo -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="{OnPlatform Android='RoundRectangle 16', iOS='RoundRectangle 26', Default='RoundRectangle 20'}" 
                            BackgroundColor="#1E293B" 
                            Stroke="#334155" 
                            StrokeThickness="1" 
                            WidthRequest="{OnPlatform Android='72', iOS='84', Default='78'}" 
                            HeightRequest="{OnPlatform Android='72', iOS='84', Default='78'}" 
                            HorizontalOptions="Center">
                        <Label Text="🚛" FontSize="{OnPlatform Android='34', iOS='40', Default='36'}" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    
                    <Label Text="LogiRoute Pro" 
                           FontSize="{OnPlatform Android='24', iOS='27', Default='26'}" 
                           FontAttributes="Bold" 
                           TextColor="#F8FAFC" 
                           HorizontalOptions="Center"/>
                    <Label Text="Навигатор грузоперевозок и доставок" 
                           FontSize="{OnPlatform Android='13', iOS='14', Default='14'}" 
                           TextColor="#94A3B8" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Login Card -->
                <Border StrokeShape="{OnPlatform Android='RoundRectangle 12', iOS='RoundRectangle 24', Default='RoundRectangle 16'}"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        StrokeThickness="1"
                        Padding="{OnPlatform Android='18,16', iOS='24,22', Default='20,18'}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Авторизация водителя" 
                               FontSize="{OnPlatform Android='17', iOS='19', Default='18'}" 
                               FontAttributes="Bold" 
                               TextColor="#F1F5F9" />

                        <!-- Driver ID -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Табельный номер (ID водителя / Логин) *" FontSize="12" TextColor="#94A3B8" />
                            <Border StrokeShape="{OnPlatform Android='RoundRectangle 8', iOS='RoundRectangle 14', Default='RoundRectangle 10'}" BackgroundColor="#0F172A" Stroke="#334155" Padding="{OnPlatform Android='12,4', iOS='14,8', Default='12,6'}">
                                <Entry Text="{Binding DriverId}" 
                                       Placeholder="Например: DRV-104" 
                                       TextColor="#F8FAFC" 
                                       PlaceholderColor="#64748B"/>
                            </Border>
                            <Label Text="{Binding DriverIdError}" 
                                   IsVisible="{Binding DriverIdError, Converter={StaticResource StringNotEmptyConverter}}"
                                   TextColor="#EF4444" 
                                   FontSize="11" />
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Пароль доступа (минимум 4 символа) *" FontSize="12" TextColor="#94A3B8" />
                            <Border StrokeShape="{OnPlatform Android='RoundRectangle 8', iOS='RoundRectangle 14', Default='RoundRectangle 10'}" BackgroundColor="#0F172A" Stroke="#334155" Padding="{OnPlatform Android='12,4', iOS='14,8', Default='12,6'}">
                                <Entry Text="{Binding Password}" 
                                       IsPassword="True" 
                                       Placeholder="Пароль учетной записи" 
                                       TextColor="#F8FAFC" 
                                       PlaceholderColor="#64748B"/>
                            </Border>
                            <Label Text="{Binding PasswordError}" 
                                   IsVisible="{Binding PasswordError, Converter={StaticResource StringNotEmptyConverter}}"
                                   TextColor="#EF4444" 
                                   FontSize="11" />
                        </VerticalStackLayout>

                        <!-- Быстрый выбор аккаунта -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Быстрый выбор профиля:" FontSize="11" TextColor="#94A3B8" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Text="DRV-104" 
                                        Command="{Binding SelectPresetDriverCommand}" 
                                        CommandParameter="DRV-104"
                                        BackgroundColor="#0F172A" 
                                        BorderColor="#334155" 
                                        BorderWidth="1" 
                                        TextColor="#38BDF8" 
                                        FontSize="11" 
                                        FontAttributes="Bold"
                                        HeightRequest="36" 
                                        CornerRadius="8" 
                                        Padding="2,0"/>
                                <Button Grid.Column="1" 
                                        Text="DRV-105" 
                                        Command="{Binding SelectPresetDriverCommand}" 
                                        CommandParameter="DRV-105"
                                        BackgroundColor="#0F172A" 
                                        BorderColor="#334155" 
                                        BorderWidth="1" 
                                        TextColor="#38BDF8" 
                                        FontSize="11" 
                                        FontAttributes="Bold"
                                        HeightRequest="36" 
                                        CornerRadius="8" 
                                        Padding="2,0"/>
                                <Button Grid.Column="2" 
                                        Text="DRV-106" 
                                        Command="{Binding SelectPresetDriverCommand}" 
                                        CommandParameter="DRV-106"
                                        BackgroundColor="#0F172A" 
                                        BorderColor="#334155" 
                                        BorderWidth="1" 
                                        TextColor="#38BDF8" 
                                        FontSize="11" 
                                        FontAttributes="Bold"
                                        HeightRequest="36" 
                                        CornerRadius="8" 
                                        Padding="2,0"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Настройки подключения -->
                        <BoxView HeightRequest="1" Color="#334155" Margin="0,4"/>

                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Switch IsToggled="{Binding UseLocalMockServer}" />
                            <VerticalStackLayout>
                                <Label Text="Локальный тестовый сервер" FontSize="13" FontAttributes="Bold" TextColor="#E2E8F0" />
                                <Label Text="Автономный режим работы приложения" FontSize="11" TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Адрес сервера -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Адрес сервера логистики" FontSize="12" TextColor="#94A3B8" />
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#0F172A" Stroke="#334155" Padding="12,4">
                                <Entry Text="{Binding ServerUrl}" 
                                       Placeholder="http://127.0.0.1:5055" 
                                       TextColor="#38BDF8" 
                                       PlaceholderColor="#64748B"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Status and Error Messages -->
                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                BackgroundColor="#450A0A"
                                Stroke="#EF4444"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,4">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="⚠️" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="{Binding ErrorMessage}" TextColor="#FCA5A5" FontSize="12" LineBreakMode="WordWrap"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                BackgroundColor="#064E3B"
                                Stroke="#10B981"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,4">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="ℹ️" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="{Binding StatusMessage}" TextColor="#A7F3D0" FontSize="12" LineBreakMode="WordWrap"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Кнопка онлайн-входа -->
                        <Button Text="Войти в систему" 
                                Command="{Binding LoginCommand}" 
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="#2563EB" 
                                TextColor="#FFFFFF" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="48"
                                FontSize="15"
                                Margin="0,4,0,0"/>

                        <!-- Кнопка автономного входа -->
                        <Button Text="⚡ Войти без подключения к сети" 
                                Command="{Binding LoginOfflineExplicitCommand}" 
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="#065F46" 
                                TextColor="#A7F3D0" 
                                FontAttributes="Bold" 
                                CornerRadius="12" 
                                HeightRequest="46"
                                FontSize="14"/>

                        <!-- Переход на экран регистрации -->
                        <Button Text="📝 Регистрация нового водителя" 
                                Command="{Binding NavigateToRegisterCommand}" 
                                BackgroundColor="Transparent" 
                                TextColor="#38BDF8" 
                                FontSize="13"
                                CornerRadius="8"
                                HeightRequest="38"/>

                        <!-- Cancel Request Button (Visible when busy) -->
                        <Button Text="Отмена" 
                                Command="{Binding CancelCurrentOperationCommand}" 
                                IsVisible="{Binding IsBusy}"
                                BackgroundColor="#DC2626" 
                                TextColor="#FFFFFF" 
                                FontAttributes="Bold" 
                                CornerRadius="10" 
                                HeightRequest="40"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Footer info -->
                <Label Text="LogiRoute Pro • Система управления доставками&#10;Версия для водителей и экспедиторов" 
                       FontSize="11" 
                       TextColor="#475569" 
                       HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsBusy}">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#38BDF8" WidthRequest="50" HeightRequest="50"/>
                <Label Text="Вход в систему..." TextColor="#F8FAFC" FontSize="14" HorizontalOptions="Center"/>
                <Button Text="Отмена" 
                        Command="{Binding CancelCurrentOperationCommand}" 
                        BackgroundColor="#EF4444" 
                        TextColor="White" 
                        CornerRadius="8" 
                        HeightRequest="40" 
                        Padding="16,0"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
