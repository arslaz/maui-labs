<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:laba12.ViewModels"
             xmlns:models="clr-namespace:laba12.Models"
             xmlns:conv="clr-namespace:laba12.Converters"
             x:Class="laba12.Views.DeliveriesPage"
             x:DataType="vm:DeliveriesViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0B132B">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToInvertedConverter x:Key="InvertedBoolConverter" />
            <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyConverter" />
            <conv:StatusColorConverter x:Key="StatusColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="iOS" Value="0,48,0,0" />
            <On Platform="Android" Value="0,12,0,0" />
            <On Platform="Default" Value="0,0,0,0" />
        </OnPlatform>
    </ContentPage.Padding>

    <Grid RowDefinitions="*,Auto">

        <!-- Основной список нарядов со скроллом -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#38BDF8">
            <CollectionView ItemsSource="{Binding Deliveries}"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            Margin="{OnPlatform Android='10,0', iOS='14,0', Default='12,0'}">

                <!-- ===== ШАПКА ВОДИТЕЛЯ И ПАНЕЛЬ УПРАВЛЕНИЯ ===== -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,8">

                        <!-- Карточка водителя и профиля смены -->
                        <Border BackgroundColor="#1C2541"
                                Stroke="#3A506B"
                                StrokeThickness="1"
                                Padding="{OnPlatform Android='14,10', iOS='16,12', Default='14,10'}"
                                StrokeShape="{OnPlatform Android='RoundRectangle 12', iOS='RoundRectangle 20', Default='RoundRectangle 14'}">
                            <VerticalStackLayout Spacing="10">
                                
                                <!-- Строка водителя -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <!-- Аватар -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="#2563EB"
                                            WidthRequest="42" HeightRequest="42"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="🚛" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Имя и автомобиль -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding DriverName}" 
                                               FontAttributes="Bold" 
                                               FontSize="15" 
                                               TextColor="#F8FAFC"
                                               LineBreakMode="TailTruncation"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#0F172A" Padding="5,1">
                                                <Label Text="{Binding DriverId}" FontSize="10" TextColor="#38BDF8" FontAttributes="Bold"/>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding VehicleNumber}" FontSize="11" TextColor="#94A3B8" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <!-- Сетевой статус и кнопка выхода -->
                                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 8" 
                                                BackgroundColor="{Binding NetworkBadgeBgColor}"
                                                Padding="7,4">
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" 
                                                         Color="{Binding NetworkStatusColor}"/>
                                                <Label Text="{Binding NetworkStatusBadgeText}" 
                                                       FontSize="10" 
                                                       FontAttributes="Bold" 
                                                       TextColor="{Binding NetworkStatusColor}"/>
                                            </HorizontalStackLayout>
                                        </Border>

                                        <Button Text="Выйти" 
                                                Command="{Binding LogoutCommand}" 
                                                BackgroundColor="#334155" 
                                                TextColor="#CBD5E1" 
                                                FontSize="11" 
                                                Padding="8,0" 
                                                HeightRequest="28"
                                                CornerRadius="6"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Разделитель -->
                                <BoxView HeightRequest="1" Color="#283548"/>

                                <!-- Телеметрия и скорость -->
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="📶" FontSize="12" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding TelemetryStatusText}" 
                                               FontSize="11" 
                                               TextColor="#94A3B8" 
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                    <Label Grid.Column="1" Text="{Binding VehicleSpeedText}" FontSize="12" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center"/>
                                </Grid>

                                <!-- Основная панель действий водителя (5 кнопок) -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    
                                    <!-- 1. Маршрут -->
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Text="🗺️ Маршрут" 
                                            Command="{Binding PlotRouteCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#2563EB" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="36" 
                                            CornerRadius="8" 
                                            Padding="6,0"/>

                                    <!-- 2. Приёмка груза со склада (Реальная операция с ACID Commit/Rollback) -->
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Text="📦 Приёмка груза" 
                                            Command="{Binding ReceiveCargoManifestCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#059669" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="36" 
                                            CornerRadius="8" 
                                            Padding="6,0"/>

                                    <!-- 3. Отчёт о расходе топлива -->
                                    <Button Grid.Row="1" Grid.Column="0"
                                            Text="⛽ Отчёт топлива" 
                                            Command="{Binding GenerateAndUploadFuelReportCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#0F766E" 
                                            TextColor="#CCFBF1" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="36" 
                                            CornerRadius="8" 
                                            Padding="6,0"/>

                                    <!-- 4. Комплексная синхронизация -->
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Text="🔄 Синхронизация" 
                                            Command="{Binding SyncAllDataCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#D97706" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="36" 
                                            CornerRadius="8" 
                                            Padding="6,0"/>

                                    <!-- 5. Вариант 7: Агрегированная сводка по категориям грузов (Сложный связывающий SQL JOIN) -->
                                    <Button Grid.Row="2" Grid.ColumnSpan="2"
                                            Text="{Binding RegulationsSummaryButtonText}" 
                                            Command="{Binding ShowCargoRegulationsSummaryCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#4F46E5" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="36" 
                                            CornerRadius="8" 
                                            Padding="6,0"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Вариант 7: Красивая визуальная панель агрегированной сводки категорий грузов (SQL JOIN) -->
                        <Border IsVisible="{Binding IsRegulationsSummaryVisible}"
                                BackgroundColor="#131B38"
                                Stroke="#4F46E5"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10"
                                Margin="0,2,0,4">
                            <VerticalStackLayout Spacing="8">
                                <!-- Шапка блока сводки -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="📊" FontSize="16" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="Сводка требований и режимов грузов" 
                                               FontAttributes="Bold" 
                                               FontSize="13" 
                                               TextColor="#F8FAFC"/>
                                        <Label Text="Сложный запрос: INNER JOIN cargo_categories + delivery_points" 
                                               FontSize="9" 
                                               TextColor="#A5B4FC"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" 
                                            Text="✕ Скрыть" 
                                            Command="{Binding HideRegulationsSummaryCommand}" 
                                            BackgroundColor="#312E81" 
                                            TextColor="#C7D2FE" 
                                            FontSize="10" 
                                            HeightRequest="26" 
                                            Padding="8,0" 
                                            CornerRadius="6"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#3730A3"/>

                                <!-- Карточки категорий грузов -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding CargoCategoryReports}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CargoCategoryAggregatedReport">
                                            <Border BackgroundColor="#0F172A"
                                                    Stroke="#1E293B"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="10,8">
                                                <VerticalStackLayout Spacing="6">
                                                    <!-- Верхняя строка: Иконка + Категория + Код -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                        <Label Grid.Column="0" Text="{Binding IconGlyph}" FontSize="15" VerticalOptions="Center"/>
                                                        <Label Grid.Column="1" 
                                                               Text="{Binding CategoryName}" 
                                                               FontAttributes="Bold" 
                                                               FontSize="12" 
                                                               TextColor="#E2E8F0" 
                                                               LineBreakMode="TailTruncation"
                                                               VerticalOptions="Center"/>
                                                        <Border Grid.Column="2" 
                                                                StrokeShape="RoundRectangle 4" 
                                                                BackgroundColor="#1E1B4B" 
                                                                Stroke="#4338CA" 
                                                                Padding="5,1">
                                                            <Label Text="{Binding CategoryCode}" FontSize="9" TextColor="#C7D2FE" FontAttributes="Bold"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Температурный режим (изумрудный акцент) -->
                                                    <Border StrokeShape="RoundRectangle 6" 
                                                            BackgroundColor="#064E3B" 
                                                            Stroke="#059669" 
                                                            Padding="8,4">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                                            <Label Grid.Column="0" Text="🌡️" FontSize="11" VerticalOptions="Center"/>
                                                            <Label Grid.Column="1" 
                                                                   Text="{Binding TemperatureMode}" 
                                                                   FontSize="11" 
                                                                   TextColor="#6EE7B7" 
                                                                   FontAttributes="Bold"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Правила транспортировки -->
                                                    <Border StrokeShape="RoundRectangle 6" 
                                                            BackgroundColor="#1E293B" 
                                                            Stroke="#334155" 
                                                            Padding="8,4">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                                            <Label Grid.Column="0" Text="📋" FontSize="10" VerticalOptions="Start"/>
                                                            <Label Grid.Column="1" 
                                                                   Text="{Binding HandlingRequirements}" 
                                                                   FontSize="10" 
                                                                   TextColor="#CBD5E1" 
                                                                   LineBreakMode="WordWrap"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Метрики в смене: Наряды, Масса, Объем -->
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                        <!-- Нарядов всего -->
                                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#1E293B" Padding="4,4">
                                                            <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                                                <Label Text="Нарядов" FontSize="9" TextColor="#64748B" HorizontalOptions="Center"/>
                                                                <Label Text="{Binding TotalOrdersCount, StringFormat='{0} шт'}" 
                                                                       FontSize="11" 
                                                                       FontAttributes="Bold" 
                                                                       TextColor="#38BDF8" 
                                                                       HorizontalOptions="Center"/>
                                                            </VerticalStackLayout>
                                                        </Border>

                                                        <!-- Суммарный вес -->
                                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 4" BackgroundColor="#1E293B" Padding="4,4">
                                                            <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                                                <Label Text="Масса" FontSize="9" TextColor="#64748B" HorizontalOptions="Center"/>
                                                                <Label Text="{Binding TotalWeightKg, StringFormat='{0:F1} кг'}" 
                                                                       FontSize="11" 
                                                                       FontAttributes="Bold" 
                                                                       TextColor="#F8FAFC" 
                                                                       HorizontalOptions="Center"/>
                                                            </VerticalStackLayout>
                                                        </Border>

                                                        <!-- Суммарный объем -->
                                                        <Border Grid.Column="2" StrokeShape="RoundRectangle 4" BackgroundColor="#1E293B" Padding="4,4">
                                                            <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                                                <Label Text="Объём" FontSize="9" TextColor="#64748B" HorizontalOptions="Center"/>
                                                                <Label Text="{Binding TotalVolumeM3, StringFormat='{0:F2} м³'}" 
                                                                       FontSize="11" 
                                                                       FontAttributes="Bold" 
                                                                       TextColor="#F8FAFC" 
                                                                       HorizontalOptions="Center"/>
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Детализация статусов нарядов -->
                                                    <Label Text="{Binding OrdersBreakdownText}" 
                                                           FontSize="9" 
                                                           TextColor="#94A3B8" 
                                                           HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Индикатор состояния базы данных и транзакций -->
                        <Border BackgroundColor="#0F172A"
                                Stroke="{Binding SqliteTransactionStatusColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🛡️" FontSize="14" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding SqliteTransactionBadgeText}"
                                           TextColor="{Binding SqliteTransactionStatusColor}"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding SqliteTransactionDetails}"
                                           TextColor="#94A3B8"
                                           FontSize="10"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Баннер неотправленной телеметрии (Вариант 7) -->
                        <Border IsVisible="{Binding HasUnsyncedWaypoints}"
                                BackgroundColor="#14532D"
                                Stroke="#22C55E"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🛰️" FontSize="15" VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding UnsyncedWaypointsBadgeText}" 
                                       FontAttributes="Bold" 
                                       FontSize="11" 
                                       TextColor="#BBF7D0" 
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="2"
                                        Text="Отправить"
                                        Command="{Binding SyncOfflineWaypointsCommand}"
                                        BackgroundColor="#16A34A"
                                        TextColor="White"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        HeightRequest="26"
                                        Padding="8,0"
                                        CornerRadius="6"/>
                            </Grid>
                        </Border>

                        <!-- Баннер очереди офлайн-транзакций -->
                        <Border IsVisible="{Binding HasPendingSyncTransactions}"
                                BackgroundColor="#451A03"
                                Stroke="#F59E0B"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="📦" FontSize="15" VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding PendingSyncBadgeText}" 
                                       FontAttributes="Bold" 
                                       FontSize="11" 
                                       TextColor="#FDE68A" 
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="2" 
                                        Text="Отправить" 
                                        Command="{Binding ProcessSyncQueueCommand}" 
                                        BackgroundColor="#D97706" 
                                        TextColor="White" 
                                        FontSize="10" 
                                        FontAttributes="Bold"
                                        HeightRequest="26" 
                                        Padding="8,0"
                                        CornerRadius="6"/>
                            </Grid>
                        </Border>

                        <!-- Уведомление об операции -->
                        <Border IsVisible="{Binding StatusNotice, Converter={StaticResource StringNotEmptyConverter}}"
                                BackgroundColor="#064E3B"
                                Stroke="#10B981"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,5">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="✨" FontSize="12" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding StatusNotice}" TextColor="#A7F3D0" FontSize="11" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                            </Grid>
                        </Border>

                        <!-- Предупреждение об автономном режиме -->
                        <Border IsVisible="{Binding IsOffline}"
                                BackgroundColor="#450A0A"
                                Stroke="#DC2626"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="⚠️" FontSize="14" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Автономный режим (нет сети). Изменения сохраняются локально." FontSize="11" TextColor="#FECACA" VerticalOptions="Center"/>
                                <Button Grid.Column="2" 
                                        Text="Повтор" 
                                        Command="{Binding RefreshCommand}" 
                                        BackgroundColor="#DC2626" 
                                        TextColor="White" 
                                        FontSize="10" 
                                        HeightRequest="24" 
                                        Padding="6,0"
                                        CornerRadius="4"/>
                            </Grid>
                        </Border>

                        <!-- Компактная карточка маршрутного плана -->
                        <Border BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Маршрутный лист на смену" FontSize="10" TextColor="#94A3B8"/>
                                    <Label Text="{Binding RouteSummary, FallbackValue='Маршрут не рассчитан'}" 
                                           FontSize="12" 
                                           FontAttributes="Bold" 
                                           TextColor="#38BDF8" 
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="🗺️ Карта"
                                        Command="{Binding OpenMapCommand}"
                                        BackgroundColor="#0284C7"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        HeightRequest="30"
                                        CornerRadius="6"
                                        Padding="8,0"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Индикатор загрузки с отменой -->
                        <Border IsVisible="{Binding IsBusy}"
                                BackgroundColor="#1E293B"
                                Stroke="#EAB308"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <ActivityIndicator Grid.Column="0" IsRunning="True" Color="#EAB308" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Выполняется операция..." TextColor="#FEF08A" FontSize="11" VerticalOptions="Center"/>
                                <Button Grid.Column="2" 
                                        Text="Отмена" 
                                        Command="{Binding CancelCurrentOperationCommand}" 
                                        BackgroundColor="#DC2626" 
                                        TextColor="White" 
                                        FontSize="10" 
                                        HeightRequest="24" 
                                        Padding="8,0"
                                        CornerRadius="4"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- Пустой список -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="28">
                        <Label Text="📦" FontSize="42" HorizontalOptions="Center"/>
                        <Label Text="Нет запланированных доставок" 
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="#94A3B8" 
                               HorizontalOptions="Center"/>
                        <Label Text="Потяните вниз для загрузки путевого листа" 
                               FontSize="12" 
                               TextColor="#64748B" 
                               HorizontalOptions="Center"/>
                        <Button Text="Обновить список" 
                                Command="{Binding RefreshCommand}" 
                                BackgroundColor="#2563EB" 
                                TextColor="White" 
                                CornerRadius="8"
                                HeightRequest="36"
                                Padding="14,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Шаблон карточки наряда -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeliveryPoint">
                        <SwipeView Margin="0,4">
                            <!-- Свайп влево для быстрых действий -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Прибытие"
                                               BackgroundColor="#06B6D4"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=MarkArrivalCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Отказ"
                                               BackgroundColor="#E11D48"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=RejectCargoCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Удалить"
                                               BackgroundColor="#DC2626"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=DeleteDeliveryCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Карточка точки доставки -->
                            <Border StrokeShape="{OnPlatform Android='RoundRectangle 10', iOS='RoundRectangle 16', Default='RoundRectangle 12'}"
                                    BackgroundColor="#1E293B"
                                    Stroke="#334155"
                                    StrokeThickness="1"
                                    Padding="{OnPlatform Android='12,10', iOS='14,12', Default='12,10'}">
                                
                                <!-- Контекстное меню (ПКМ / Долгое нажатие) -->
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="📍 Отметить прибытие"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=MarkArrivalCommand}"
                                                        CommandParameter="{Binding .}"/>
                                        <MenuFlyoutItem Text="❌ Зафиксировать отказ от груза"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=RejectCargoCommand}"
                                                        CommandParameter="{Binding .}"/>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="🗑️ Удалить наряд"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=DeleteDeliveryCommand}"
                                                        CommandParameter="{Binding .}"/>
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=SelectDeliveryCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                                    
                                    <!-- Строка 0: Номер наряда, приоритет, статусы и кнопка меню ⋮ -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#0F172A" Padding="6,2">
                                            <Label Text="{Binding OrderNumber}" FontAttributes="Bold" FontSize="11" TextColor="#38BDF8"/>
                                        </Border>
                                        
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 4" BackgroundColor="#374151" Padding="5,2">
                                            <Label Text="{Binding Priority}" FontSize="10" TextColor="#F3F4F6"/>
                                        </Border>

                                        <!-- Индикатор очереди офлайн-синхронизации -->
                                        <Border Grid.Column="3" 
                                                IsVisible="{Binding IsSyncPending}"
                                                StrokeShape="RoundRectangle 4" 
                                                BackgroundColor="#78350F" 
                                                Padding="5,2"
                                                VerticalOptions="Center">
                                            <Label Text="⏳ В очереди" FontSize="9" TextColor="#FDE68A" FontAttributes="Bold"/>
                                        </Border>

                                        <!-- Статус наряда -->
                                        <Border Grid.Column="4" 
                                                StrokeShape="RoundRectangle 8" 
                                                BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" 
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Status}" 
                                                   FontSize="10" 
                                                   FontAttributes="Bold" 
                                                   TextColor="White"/>
                                        </Border>

                                        <!-- Кнопка вызова контекстного меню (⋮) -->
                                        <Button Grid.Column="5"
                                                Text="⋮"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="#CBD5E1"
                                                BackgroundColor="#0F172A"
                                                WidthRequest="28"
                                                HeightRequest="26"
                                                Padding="0"
                                                CornerRadius="5"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=ShowItemContextMenuCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>

                                    <!-- Строка 1: Имя клиента (с переносом строки при необходимости) -->
                                    <Label Grid.Row="1" 
                                           Text="{Binding ClientName}" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#F8FAFC"
                                           LineBreakMode="WordWrap"/>

                                    <!-- Строка 2: Адрес (с гарантированным переносом строки) -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="📍" FontSize="12" VerticalOptions="Start"/>
                                        <Label Grid.Column="1" Text="{Binding Address}" FontSize="12" TextColor="#CBD5E1" LineBreakMode="WordWrap"/>
                                    </Grid>

                                    <!-- Строка 3: Характеристика груза, вес и время -->
                                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="📦" FontSize="11" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding CargoDescription, StringFormat='{0}'}" 
                                                   FontSize="11" 
                                                   TextColor="#94A3B8" 
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>
                                        </Grid>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding WeightKg, StringFormat='{0} кг'}" FontSize="11" TextColor="#94A3B8" VerticalOptions="Center"/>
                                            <Border StrokeShape="RoundRectangle 4" BackgroundColor="#0F172A" Padding="5,2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                                    <Label Text="⏱️" FontSize="9"/>
                                                    <Label Text="{Binding EstimatedTime}" FontSize="10" TextColor="#E2E8F0" FontAttributes="Bold"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Строка 4: Вариант 7: Категория, температурный режим и регламент (SQL JOIN) -->
                                    <Border Grid.Row="4"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#0F172A"
                                            Stroke="#1E293B"
                                            StrokeThickness="1"
                                            Padding="8,6"
                                            Margin="0,2,0,0">
                                        <VerticalStackLayout Spacing="5">
                                            <!-- Верхняя строка: Категория слева (50%), Температурный режим справа (50%) -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" VerticalOptions="Center">
                                                <!-- Плашка категории груза -->
                                                <Border Grid.Column="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        BackgroundColor="#1E1B4B"
                                                        Stroke="#4338CA"
                                                        StrokeThickness="1"
                                                        Padding="6,4"
                                                        HorizontalOptions="Fill">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalOptions="Center">
                                                        <Label Grid.Column="0" 
                                                               Text="{Binding CargoIconGlyph}" 
                                                               FontSize="11" 
                                                               VerticalOptions="Center"/>
                                                        <Label Grid.Column="1" 
                                                               Text="{Binding CargoCategoryName}" 
                                                               FontSize="10" 
                                                               TextColor="#C7D2FE" 
                                                               FontAttributes="Bold" 
                                                               LineBreakMode="TailTruncation"
                                                               VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Плашка температурного режима -->
                                                <Border Grid.Column="1"
                                                        StrokeShape="RoundRectangle 6"
                                                        BackgroundColor="#064E3B"
                                                        Stroke="#059669"
                                                        StrokeThickness="1"
                                                        Padding="6,4"
                                                        HorizontalOptions="Fill">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalOptions="Center">
                                                        <Label Grid.Column="0" 
                                                               Text="🌡️" 
                                                               FontSize="10" 
                                                               VerticalOptions="Center"/>
                                                        <Label Grid.Column="1" 
                                                               Text="{Binding CargoTemperatureMode}" 
                                                               FontSize="10" 
                                                               TextColor="#6EE7B7" 
                                                               FontAttributes="Bold" 
                                                               LineBreakMode="TailTruncation"
                                                               VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- Нижняя строка: Регламент перевозки (справочник ограничений) -->
                                            <Border StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="#131C31"
                                                    Stroke="#1E293B"
                                                    StrokeThickness="1"
                                                    Padding="6,3">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalOptions="Center">
                                                    <Label Grid.Column="0" Text="📋" FontSize="10" VerticalOptions="Start"/>
                                                    <Label Grid.Column="1" 
                                                           Text="{Binding CargoHandlingRequirements}" 
                                                           FontSize="10" 
                                                           TextColor="#94A3B8" 
                                                           LineBreakMode="TailTruncation"/>
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Строка 5: Примечания / отметки времени / причины отказа -->
                                    <Border Grid.Row="5" 
                                            IsVisible="{Binding Notes, Converter={StaticResource StringNotEmptyConverter}}"
                                            BackgroundColor="#0F172A"
                                            Stroke="#334155"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,3"
                                            Margin="0,2,0,0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="📝" FontSize="10" VerticalOptions="Start"/>
                                            <Label Grid.Column="1" Text="{Binding Notes}" FontSize="11" TextColor="#94A3B8" LineBreakMode="WordWrap"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Индикатор дозагрузки при пагинации -->
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="10" HorizontalOptions="Center" IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}" Color="#38BDF8" WidthRequest="24" HeightRequest="24"/>
                        <Label Text="Загрузка следующей страницы..." FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center" Margin="0,3,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Нижняя статусная панель (закреплена внизу экрана) -->
        <Border Grid.Row="1"
                BackgroundColor="#0F172A"
                Stroke="#1E293B"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{Binding LastUpdatedText, FallbackValue='Готово к работе'}" 
                       FontSize="11" 
                       TextColor="#64748B" 
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"/>

                <!-- Кнопка сведений о смене / Путевой лист (для демонстрации БД преподавателю) -->
                <Button Grid.Column="1"
                        Text="📋 Путевой лист"
                        Command="{Binding ViewDatabaseInfoCommand}"
                        BackgroundColor="#1E293B"
                        TextColor="#38BDF8"
                        FontSize="11"
                        FontAttributes="Bold"
                        HeightRequest="28"
                        Padding="8,0"
                        CornerRadius="6"
                        VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                    <Label Text="Нарядов:" FontSize="11" TextColor="#94A3B8" VerticalOptions="Center"/>
                    <Label Text="{Binding TotalCount}" FontSize="11" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
