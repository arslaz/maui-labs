<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:laba12.ViewModels"
             xmlns:models="clr-namespace:laba12.Models"
             xmlns:conv="clr-namespace:laba12.Converters"
             x:Class="laba12.Views.DeliveriesPage"
             x:DataType="vm:DeliveriesViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0B132B">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToInvertedConverter x:Key="InvertedBoolConverter" />
            <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyConverter" />
            <conv:StatusColorConverter x:Key="StatusColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="iOS" Value="0,48,0,0" />
            <On Platform="Android" Value="0,12,0,0" />
            <On Platform="Default" Value="0,0,0,0" />
        </OnPlatform>
    </ContentPage.Padding>

    <Grid RowDefinitions="*,Auto">

        <!-- Основной список нарядов со скроллом -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#38BDF8">
            <CollectionView ItemsSource="{Binding Deliveries}"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            Margin="{OnPlatform Android='10,0', iOS='14,0', Default='12,0'}">

                <!-- ===== ШАПКА ВОДИТЕЛЯ И ПАНЕЛЬ УПРАВЛЕНИЯ ===== -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,8">

                        <!-- Карточка водителя и профиля смены -->
                        <Border BackgroundColor="#1C2541"
                                Stroke="#3A506B"
                                StrokeThickness="1"
                                Padding="{OnPlatform Android='14,12', iOS='16,14', Default='14,12'}"
                                StrokeShape="{OnPlatform Android='RoundRectangle 12', iOS='RoundRectangle 20', Default='RoundRectangle 14'}">
                            <VerticalStackLayout Spacing="10">
                                
                                <!-- Верхняя строка: Аватар, имя, автомобиль и индикатор связи -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <!-- Аватар -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="#2563EB"
                                            WidthRequest="42" HeightRequest="42"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="🚛" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Имя и автомобиль -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding DriverName}" 
                                               FontAttributes="Bold" 
                                               FontSize="15" 
                                               TextColor="#F8FAFC"
                                               LineBreakMode="TailTruncation"/>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 4" BackgroundColor="#0F172A" Padding="5,1">
                                                <Label Text="{Binding DriverId}" FontSize="10" TextColor="#38BDF8" FontAttributes="Bold"/>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding VehicleNumber}" FontSize="11" TextColor="#94A3B8" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <!-- Сетевой статус бейдж -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 8" 
                                            BackgroundColor="{Binding NetworkBadgeBgColor}"
                                            Padding="8,5"
                                            VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" 
                                                     Color="{Binding NetworkStatusColor}"/>
                                            <Label Text="{Binding NetworkStatusBadgeText}" 
                                                   FontSize="10" 
                                                   FontAttributes="Bold" 
                                                   TextColor="{Binding NetworkStatusColor}"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Разделитель -->
                                <BoxView HeightRequest="1" Color="#283548"/>

                                <!-- Нижняя строка карточки: Телеметрия / Скорость слева, Кнопки Профиль и Выход справа -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="📶" FontSize="12" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" VerticalOptions="Center" LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding TelemetryStatusText}" FontSize="11" TextColor="#94A3B8"/>
                                                    <Span Text=" • " FontSize="11" TextColor="#475569"/>
                                                    <Span Text="{Binding VehicleSpeedText}" FontSize="11" TextColor="#38BDF8" FontAttributes="Bold"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>

                                    <Button Grid.Column="1"
                                            Text="👤 Профиль" 
                                            Command="{Binding OpenProfileCommand}" 
                                            BackgroundColor="#0284C7" 
                                            TextColor="#FFFFFF" 
                                            FontSize="11" 
                                            FontAttributes="Bold"
                                            Padding="10,0" 
                                            HeightRequest="30"
                                            CornerRadius="8"
                                            VerticalOptions="Center"/>

                                    <Button Grid.Column="2"
                                            Text="🚪 Выйти" 
                                            Command="{Binding LogoutCommand}" 
                                            BackgroundColor="#334155" 
                                            TextColor="#CBD5E1" 
                                            FontSize="11" 
                                            Padding="10,0" 
                                            HeightRequest="30"
                                            CornerRadius="8"
                                            VerticalOptions="Center"/>
                                </Grid>

                                <!-- Основная панель действий водителя (5 кнопок) -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    
                                    <!-- 1. Маршрут -->
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Text="🗺️ Маршрут" 
                                            Command="{Binding PlotRouteCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#2563EB" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="40" 
                                            CornerRadius="10" 
                                            Padding="6,0"/>

                                    <!-- 2. Приёмка груза со склада -->
                                    <Button Grid.Row="0" Grid.Column="1"
                                            Text="📦 Приёмка груза" 
                                            Command="{Binding ReceiveCargoManifestCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#059669" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="40" 
                                            CornerRadius="10" 
                                            Padding="6,0"/>

                                    <!-- 3. Отчёт о расходе топлива -->
                                    <Button Grid.Row="1" Grid.Column="0"
                                            Text="⛽ Отчёт топлива" 
                                            Command="{Binding GenerateAndUploadFuelReportCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#0D9488" 
                                            TextColor="#CCFBF1" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="40" 
                                            CornerRadius="10" 
                                            Padding="6,0"/>

                                    <!-- 4. Комплексная синхронизация -->
                                    <Button Grid.Row="1" Grid.Column="1"
                                            Text="🔄 Синхронизация" 
                                            Command="{Binding SyncAllDataCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#D97706" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="40" 
                                            CornerRadius="10" 
                                            Padding="6,0"/>

                                    <!-- 5. Сводка по категориям грузов -->
                                    <Button Grid.Row="2" Grid.ColumnSpan="2"
                                            Text="📊 Сводка по категориям грузов" 
                                            Command="{Binding ShowCargoRegulationsSummaryCommand}" 
                                            IsEnabled="{Binding IsNotBusy}"
                                            BackgroundColor="#4F46E5" 
                                            TextColor="White" 
                                            FontSize="12" 
                                            FontAttributes="Bold" 
                                            HeightRequest="40" 
                                            CornerRadius="10" 
                                            Padding="6,0"/>

                                </Grid>
                            </VerticalStackLayout>
                        </Border>


                        <!-- Индикатор состояния базы данных и транзакций -->
                        <Border BackgroundColor="#0F172A"
                                Stroke="{Binding SqliteTransactionStatusColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🛡️" FontSize="14" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding SqliteTransactionBadgeText}"
                                           TextColor="{Binding SqliteTransactionStatusColor}"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding SqliteTransactionDetails}"
                                           TextColor="#94A3B8"
                                           FontSize="10"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Баннер неотправленной телеметрии -->
                        <Border IsVisible="{Binding HasUnsyncedWaypoints}"
                                BackgroundColor="#14532D"
                                Stroke="#22C55E"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🛰️" FontSize="16" VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding UnsyncedWaypointsBadgeText}" 
                                       FontAttributes="Bold" 
                                       FontSize="11" 
                                       TextColor="#BBF7D0" 
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="2"
                                        Text="Отправить"
                                        Command="{Binding SyncOfflineWaypointsCommand}"
                                        BackgroundColor="#16A34A"
                                        TextColor="White"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="30"
                                        Padding="12,0"
                                        CornerRadius="8"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Баннер очереди офлайн-транзакций -->
                        <Border IsVisible="{Binding HasPendingSyncTransactions}"
                                BackgroundColor="#451A03"
                                Stroke="#F59E0B"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="📦" FontSize="16" VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding PendingSyncBadgeText}" 
                                       FontAttributes="Bold" 
                                       FontSize="11" 
                                       TextColor="#FDE68A" 
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="2" 
                                        Text="Отправить" 
                                        Command="{Binding ProcessSyncQueueCommand}" 
                                        BackgroundColor="#D97706" 
                                        TextColor="White" 
                                        FontSize="11" 
                                        FontAttributes="Bold"
                                        HeightRequest="30" 
                                        Padding="12,0"
                                        CornerRadius="8"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Уведомление об операции -->
                        <Border IsVisible="{Binding StatusNotice, Converter={StaticResource StringNotEmptyConverter}}"
                                BackgroundColor="#064E3B"
                                Stroke="#10B981"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="✨" FontSize="14" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding StatusNotice}" TextColor="#A7F3D0" FontSize="11" VerticalOptions="Center" LineBreakMode="WordWrap"/>
                            </Grid>
                        </Border>

                        <!-- Предупреждение об автономном режиме -->
                        <Border IsVisible="{Binding IsOffline}"
                                BackgroundColor="#450A0A"
                                Stroke="#DC2626"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="⚠️" FontSize="15" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Автономный режим: изменения сохраняются на устройстве" FontSize="11" TextColor="#FECACA" VerticalOptions="Center"/>
                                <Button Grid.Column="2" 
                                        Text="Повтор" 
                                        Command="{Binding RefreshCommand}" 
                                        BackgroundColor="#DC2626" 
                                        TextColor="White" 
                                        FontSize="11" 
                                        FontAttributes="Bold"
                                        HeightRequest="28" 
                                        Padding="10,0"
                                        CornerRadius="6"/>
                            </Grid>
                        </Border>

                        <!-- Компактная карточка маршрутного плана -->
                        <Border BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Маршрутный лист на смену" FontSize="10" TextColor="#94A3B8"/>
                                    <Label Text="{Binding RouteSummary, FallbackValue='Маршрут не рассчитан'}" 
                                           FontSize="12" 
                                           FontAttributes="Bold" 
                                           TextColor="#38BDF8" 
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="🗺️ Карта"
                                        Command="{Binding OpenMapCommand}"
                                        BackgroundColor="#0284C7"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        HeightRequest="32"
                                        CornerRadius="8"
                                        Padding="12,0"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Индикатор загрузки с отменой -->
                        <Border IsVisible="{Binding IsBusy}"
                                BackgroundColor="#1E293B"
                                Stroke="#EAB308"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <ActivityIndicator Grid.Column="0" IsRunning="True" Color="#EAB308" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Выполняется операция..." TextColor="#FEF08A" FontSize="11" VerticalOptions="Center"/>
                                <Button Grid.Column="2" 
                                        Text="Отмена" 
                                        Command="{Binding CancelCurrentOperationCommand}" 
                                        BackgroundColor="#DC2626" 
                                        TextColor="White" 
                                        FontSize="11" 
                                        FontAttributes="Bold"
                                        HeightRequest="28" 
                                        Padding="10,0"
                                        CornerRadius="6"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- Пустой список -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="28">
                        <Label Text="📦" FontSize="42" HorizontalOptions="Center"/>
                        <Label Text="Нет запланированных доставок" 
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="#94A3B8" 
                               HorizontalOptions="Center"/>
                        <Label Text="Потяните вниз для загрузки путевого листа" 
                               FontSize="12" 
                               TextColor="#64748B" 
                               HorizontalOptions="Center"/>
                        <Button Text="Обновить список" 
                                Command="{Binding RefreshCommand}" 
                                BackgroundColor="#2563EB" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="10"
                                HeightRequest="40"
                                Padding="16,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Шаблон карточки наряда -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DeliveryPoint">
                        <SwipeView Margin="0,4">
                            <!-- Свайп влево для быстрых действий -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Прибытие"
                                               BackgroundColor="#06B6D4"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=MarkArrivalCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Отказ"
                                               BackgroundColor="#E11D48"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=RejectCargoCommand}"
                                               CommandParameter="{Binding .}"/>
                                    <SwipeItem Text="Удалить"
                                               BackgroundColor="#DC2626"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=DeleteDeliveryCommand}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Карточка точки доставки -->
                            <Border StrokeShape="{OnPlatform Android='RoundRectangle 10', iOS='RoundRectangle 16', Default='RoundRectangle 12'}"
                                    BackgroundColor="#1E293B"
                                    Stroke="#334155"
                                    StrokeThickness="1"
                                    Padding="{OnPlatform Android='12,10', iOS='14,12', Default='12,10'}">
                                
                                <!-- Контекстное меню (ПКМ / Долгое нажатие) -->
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="📍 Отметить прибытие"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=MarkArrivalCommand}"
                                                        CommandParameter="{Binding .}"/>
                                        <MenuFlyoutItem Text="❌ Зафиксировать отказ от груза"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=RejectCargoCommand}"
                                                        CommandParameter="{Binding .}"/>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="🗑️ Удалить наряд"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=DeleteDeliveryCommand}"
                                                        CommandParameter="{Binding .}"/>
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=SelectDeliveryCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                                    
                                    <!-- Строка 0: Номер наряда, приоритет, статусы и кнопка меню ⋮ -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 5" BackgroundColor="#0F172A" Stroke="#334155" Padding="6,2">
                                            <Label Text="{Binding OrderNumber}" FontAttributes="Bold" FontSize="11" TextColor="#38BDF8"/>
                                        </Border>
                                        
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 5" BackgroundColor="#1E293B" Stroke="#334155" Padding="5,2">
                                            <Label Text="{Binding Priority}" FontSize="10" TextColor="#F3F4F6"/>
                                        </Border>

                                        <!-- Индикатор очереди офлайн-синхронизации -->
                                        <Border Grid.Column="2" 
                                                IsVisible="{Binding IsSyncPending}"
                                                StrokeShape="RoundRectangle 5" 
                                                BackgroundColor="#78350F" 
                                                Padding="5,2"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                            <Label Text="⏳ В очереди" FontSize="9" TextColor="#FDE68A" FontAttributes="Bold"/>
                                        </Border>

                                        <!-- Статус наряда -->
                                        <Border Grid.Column="3" 
                                                StrokeShape="RoundRectangle 6" 
                                                BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" 
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Status}" 
                                                   FontSize="10" 
                                                   FontAttributes="Bold" 
                                                   TextColor="White"/>
                                        </Border>

                                        <!-- Кнопка вызова контекстного меню (⋮) -->
                                        <Border Grid.Column="4"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="#0F172A"
                                                Stroke="#334155"
                                                StrokeThickness="1"
                                                WidthRequest="30"
                                                HeightRequest="26"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveriesViewModel}}, Path=ShowItemContextMenuCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="⋮"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#CBD5E1"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Строка 1: Имя клиента (с переносом строки при необходимости) -->
                                    <Label Grid.Row="1" 
                                           Text="{Binding ClientName}" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#F8FAFC"
                                           LineBreakMode="WordWrap"/>

                                    <!-- Строка 2: Адрес (с гарантированным переносом строки) -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="📍" FontSize="12" VerticalOptions="Start"/>
                                        <Label Grid.Column="1" Text="{Binding Address}" FontSize="12" TextColor="#CBD5E1" LineBreakMode="WordWrap"/>
                                    </Grid>

                                    <!-- Строка 3: Характеристика груза, вес и время -->
                                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="📦" FontSize="11" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding CargoDescription, StringFormat='{0}'}" 
                                                   FontSize="11" 
                                                   TextColor="#94A3B8" 
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>
                                        </Grid>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding WeightKg, StringFormat='{0} кг'}" FontSize="11" TextColor="#94A3B8" VerticalOptions="Center"/>
                                            <Border StrokeShape="RoundRectangle 4" BackgroundColor="#0F172A" Padding="5,2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                                    <Label Text="⏱️" FontSize="9"/>
                                                    <Label Text="{Binding EstimatedTime}" FontSize="10" TextColor="#E2E8F0" FontAttributes="Bold"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Строка 4: Категория груза и температурный режим -->
                                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 6" BackgroundColor="#1E1B4B" Stroke="#4338CA" Padding="7,3" VerticalOptions="Center">
                                            <Label Text="{Binding CargoBadgeText}" FontSize="10" TextColor="#A5B4FC" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                        </Border>

                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 6" BackgroundColor="#064E3B" Stroke="#059669" Padding="7,3" VerticalOptions="Center">
                                            <Label Text="{Binding CargoTemperatureBadge}" FontSize="10" TextColor="#6EE7B7" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Строка 5: Примечания / отметки времени / причины отказа -->
                                    <Border Grid.Row="5" 
                                            IsVisible="{Binding Notes, Converter={StaticResource StringNotEmptyConverter}}"
                                            BackgroundColor="#0F172A"
                                            Stroke="#334155"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="6,3"
                                            Margin="0,2,0,0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="📝" FontSize="10" VerticalOptions="Start"/>
                                            <Label Grid.Column="1" Text="{Binding Notes}" FontSize="11" TextColor="#94A3B8" LineBreakMode="WordWrap"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Индикатор дозагрузки при пагинации -->
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="10" HorizontalOptions="Center" IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}" Color="#38BDF8" WidthRequest="24" HeightRequest="24"/>
                        <Label Text="Загрузка следующей страницы..." FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center" Margin="0,3,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Нижняя статусная панель (закреплена внизу экрана) -->
        <Border Grid.Row="1"
                BackgroundColor="#0F172A"
                Stroke="#1E293B"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                Padding="14,8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{Binding LastUpdatedText, FallbackValue='Готово к работе'}" 
                       FontSize="11" 
                       TextColor="#94A3B8" 
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"/>

                <!-- Кнопка сведений о смене / Путевой лист -->
                <Button Grid.Column="1"
                        Text="📋 Путевой лист"
                        Command="{Binding ViewDatabaseInfoCommand}"
                        BackgroundColor="#1E293B"
                        BorderColor="#334155"
                        BorderWidth="1"
                        TextColor="#38BDF8"
                        FontSize="11"
                        FontAttributes="Bold"
                        HeightRequest="32"
                        Padding="10,0"
                        CornerRadius="8"
                        VerticalOptions="Center"/>

                <Border Grid.Column="2" StrokeShape="RoundRectangle 6" BackgroundColor="#1E293B" Padding="8,4" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="Нарядов:" FontSize="11" TextColor="#94A3B8" VerticalOptions="Center"/>
                        <Label Text="{Binding TotalCount}" FontSize="11" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
