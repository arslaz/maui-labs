<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:laba67.Controls"
             xmlns:pages="clr-namespace:laba67.Pages"
             x:Class="laba67.Pages.ReadingPage"
             x:DataType="pages:ReadingPage"
             Title="Чтение книги"
             BackgroundColor="#F8FAFC">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🔖 Закладки"
                     Clicked="OnOpenBookmarksClicked"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Reusable ContentView: BookCard showing current book info & page-based progress -->
            <controls:BookCard x:Name="CurrentBookCard"
                               BookTitle="{Binding CurrentBook.Title}"
                               Author="{Binding CurrentBook.Author}"
                               Progress="{Binding CurrentBook.Progress}"
                               PageInfo="{Binding CurrentBook.CurrentPageText}" />

            <!-- Page Flip & Navigation Panel -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#E2E8F0"
                    BackgroundColor="White"
                    Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                        <!-- Previous Page Button -->
                        <Button Grid.Column="0"
                                Text="◀ Назад"
                                BackgroundColor="#EEF2FF"
                                TextColor="#4F46E5"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                Padding="12,0"
                                CornerRadius="8"
                                Clicked="OnPreviousPageClicked"
                                IsEnabled="{Binding CurrentBook.CanGoPrevious}" />

                        <!-- Page Indicator -->
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding CurrentBook.CurrentPageText}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding CurrentBook.ProgressPercentText, StringFormat='Прочитано {0}'}"
                                   FontSize="12"
                                   TextColor="#4F46E5"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Next Page Button -->
                        <Button Grid.Column="2"
                                Text="Вперёд ▶"
                                BackgroundColor="#4F46E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                Padding="12,0"
                                CornerRadius="8"
                                Clicked="OnNextPageClicked"
                                IsEnabled="{Binding CurrentBook.CanGoNext}" />
                    </Grid>

                    <!-- Quick page slider -->
                    <Slider Minimum="1"
                            Maximum="{Binding CurrentBook.TotalPages}"
                            Value="{Binding CurrentBook.CurrentPage, Mode=TwoWay}"
                            MinimumTrackColor="#4F46E5"
                            MaximumTrackColor="#E2E8F0"
                            ThumbColor="#4F46E5"
                            Margin="4,0"
                            ValueChanged="OnSliderPageChanged" />

                    <!-- Quick Finish Button -->
                    <Button Text="Отметить книгу как прочитанную (к последней стр.)"
                            BackgroundColor="#F1F5F9"
                            TextColor="#475569"
                            FontSize="12"
                            HeightRequest="34"
                            CornerRadius="6"
                            Clicked="OnFinishBookClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Book Page Text Card (Эмуляция книжной страницы) -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#CBD5E1"
                    BackgroundColor="#FFFFFF"
                    Padding="20,18">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,2"
                            Radius="8"
                            Opacity="0.06" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <!-- Top Book Header on page -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding CurrentBook.Title}"
                               FontSize="12"
                               TextColor="#94A3B8"
                               FontAttributes="Italic"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="1"
                               Text="{Binding CurrentBook.CurrentPage, StringFormat='Стр. {0}'}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#64748B" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <!-- Text of the Current Page -->
                    <Label Text="{Binding CurrentBook.CurrentPageContent}"
                           FontSize="15"
                           TextColor="#1E293B"
                           LineHeight="1.5" />

                    <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,8,0,0" />

                    <!-- Page Footer -->
                    <Label Text="{Binding CurrentBook.CurrentPageText}"
                           FontSize="11"
                           TextColor="#94A3B8"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Add Bookmark to Current Page -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#E2E8F0"
                    BackgroundColor="White"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="🔖" FontSize="18" VerticalOptions="Center" />
                        <Label Text="Добавить закладку на эту страницу"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#1E293B"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding CurrentBook.CurrentPage, StringFormat='Закладка будет привязана к странице {0}'}"
                           FontSize="12"
                           TextColor="#64748B" />

                    <Entry x:Name="NoteEntry"
                           Placeholder="Заметка (например: важная мысль или любимая сцена)..."
                           FontSize="14"
                           BackgroundColor="#F8FAFC" />

                    <Button Text="Сохранить закладку на текущей странице"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="40"
                            Clicked="OnAddBookmarkClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Return to Catalog -->
            <Button Text="← Вернуться в каталог"
                    BackgroundColor="#64748B"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="42"
                    Margin="0,4,0,24"
                    Clicked="OnBackToCatalogClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
