<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="laba7.Views.AddTransactionPage"
             x:Name="ThisAddPage"
             Title="Новая операция"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Заголовок и пояснение данных, переданных через конструктор при навигации -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="#E2E8F0"
                    BackgroundColor="White"
                    Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="HeaderTitleLabel"
                           Text="Добавление операции"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />
                    <Label x:Name="DataTransferNoteLabel"
                           Text="Параметры переданы через конструктор страницы"
                           FontSize="12"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Border>

            <!-- Блок доступного баланса для контроля лимита расходов -->
            <Border StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="#1E293B"
                    Padding="16, 12">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Доступный баланс"
                               TextColor="#94A3B8"
                               FontSize="12" />
                        <Label x:Name="AvailableBalanceLabel"
                               Text="0 ₽"
                               TextColor="#4ADE80"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Label Text="Лимит для расходов"
                           Grid.Column="1"
                           TextColor="#94A3B8"
                           FontSize="12"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Форма ввода данных операции -->
            <Border StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="#E2E8F0"
                    BackgroundColor="White"
                    Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Поле ввода описания -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Описание операции *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155" />
                        <Entry x:Name="DescriptionEntry"
                               Placeholder="Например, Обед в кафе или Премия"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <!-- Поле ввода суммы -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Сумма операции (₽) *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155" />
                        <Entry x:Name="AmountEntry"
                               Placeholder="0.00"
                               Keyboard="Numeric"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <!-- Выбор типа операции: Доход или Расход -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Тип операции *"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155" />
                        <HorizontalStackLayout Spacing="24">
                            <RadioButton x:Name="ExpenseRadio"
                                         Content="Расход (–)"
                                         GroupName="TxType"
                                         IsChecked="True"
                                         TextColor="#DC2626" />
                            <RadioButton x:Name="IncomeRadio"
                                         Content="Доход (+)"
                                         GroupName="TxType"
                                         TextColor="#16A34A" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Кнопки действий -->
            <VerticalStackLayout Spacing="10">
                <Button Text="💾 Сохранить операцию"
                        BackgroundColor="#16A34A"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48"
                        Clicked="OnSaveClicked" />

                <Button Text="Отмена"
                        BackgroundColor="#E2E8F0"
                        TextColor="#475569"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="44"
                        Clicked="OnCancelClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
