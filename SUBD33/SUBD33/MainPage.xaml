<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SUBD33.MainPage"
             Title="Главная форма"
             BackgroundColor="#0B0F19">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="18" MaximumWidthRequest="600" HorizontalOptions="Center">
            
            <Label Text="Лабораторная работа №33" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#F8FAFC"
                   HorizontalOptions="Center" />
            
            <Label Text="Вариант 9: Нервные срывы в сессию&#10;Группа: ПО2311 (4 курс)" 
                   FontSize="16" 
                   TextColor="#94A3B8" 
                   HorizontalTextAlignment="Center" 
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="#334155" Margin="0,5" />

            <Label Text="Навигация по приложению:" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#F8FAFC" />

            <Button Text="📋 Просмотр записей (Инциденты)" 
                    Clicked="OnNavIncidentsClicked" 
                    HeightRequest="48" 
                    FontSize="16" 
                    BackgroundColor="#3B82F6" 
                    TextColor="White" />

            <Button Text="➕ Добавить инцидент" 
                    Clicked="OnNavAddIncidentClicked" 
                    HeightRequest="48" 
                    FontSize="16" 
                    BackgroundColor="#10B981" 
                    TextColor="White" />

            <Button Text="👤 Студенты и карточки" 
                    Clicked="OnNavStudentsClicked" 
                    HeightRequest="48" 
                    FontSize="16" 
                    BackgroundColor="#6366F1" 
                    TextColor="White" />

            <Button Text="📊 Форма «Запросы»" 
                    Clicked="OnNavQueriesClicked" 
                    HeightRequest="48" 
                    FontSize="16" 
                    BackgroundColor="#F59E0B" 
                    TextColor="#0F172A" 
                    FontAttributes="Bold" />

            <BoxView HeightRequest="1" Color="#334155" Margin="0,8" />

            <Label x:Name="LblDbLocation" 
                   Text="База данных: panic_db (MySQL, ADO.NET)" 
                   FontSize="13" 
                   TextColor="#10B981" 
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
