<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SUBD33.Views.AddIncidentPage"
             Title="Добавление инцидента"
             BackgroundColor="#0B0F19">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="500" HorizontalOptions="Center">
            
            <HorizontalStackLayout Spacing="10">
                <Button Text="← Назад" Clicked="OnBackClicked" HeightRequest="40" BackgroundColor="#1E293B" TextColor="White" />
                <Label Text="➕ Добавить инцидент" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Студент:" FontAttributes="Bold" TextColor="#94A3B8" />
            <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="6,0">
                <Picker x:Name="PickerStudents" 
                        Title="Выберите студента" 
                        TitleColor="#64748B"
                        TextColor="#F8FAFC"
                        ItemDisplayBinding="{Binding DisplayInfo}" />
            </Border>

            <Label Text="Дата и время:" FontAttributes="Bold" TextColor="#94A3B8" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Border Grid.Column="0" BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="6,0">
                    <DatePicker x:Name="DatePickerIncident" TextColor="#F8FAFC" Format="dd.MM.yyyy" />
                </Border>
                <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="6,0">
                    <TimePicker x:Name="TimePickerIncident" TextColor="#F8FAFC" Format="HH:mm" />
                </Border>
            </Grid>

            <Label Text="Триггер паники:" FontAttributes="Bold" TextColor="#94A3B8" />
            <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="6,0">
                <Picker x:Name="PickerTriggers" 
                        Title="Выберите триггер" 
                        TitleColor="#64748B"
                        TextColor="#F8FAFC"
                        ItemDisplayBinding="{Binding Name}" />
            </Border>

            <Label x:Name="LblPanicValue" Text="Уровень паники (1-10): 8" FontAttributes="Bold" TextColor="#F59E0B" />
            <Slider x:Name="SliderPanic" 
                    Minimum="1" 
                    Maximum="10" 
                    Value="8" 
                    MinimumTrackColor="#F59E0B"
                    MaximumTrackColor="#334155"
                    ThumbColor="#F59E0B"
                    ValueChanged="OnPanicSliderValueChanged" />

            <Label Text="Способ успокоения:" FontAttributes="Bold" TextColor="#94A3B8" />
            <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="8,0">
                <Entry x:Name="TxtCalmingMethod" 
                       Placeholder="Например: Выпил чай с ромашкой" 
                       PlaceholderColor="#64748B"
                       TextColor="#F8FAFC" />
            </Border>

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label x:Name="LblHelpedText" Text="Способ помог (Да):" TextColor="#10B981" VerticalOptions="Center" />
                <Switch x:Name="SwitchHelped" IsToggled="True" OnColor="#10B981" Toggled="OnHelpedToggled" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="💾 Сохранить запись" 
                    Clicked="OnSaveClicked" 
                    HeightRequest="48" 
                    FontSize="16" 
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
