<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SUBD33.Views.AddIncidentPage"
             Title="Добавление инцидента">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="500" HorizontalOptions="Center">
            
            <HorizontalStackLayout Spacing="10">
                <Button Text="← Назад" Clicked="OnBackClicked" HeightRequest="40" />
                <Label Text="➕ Добавить инцидент" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Поле 1: Студент -->
            <Label Text="Студент:" FontAttributes="Bold" />
            <Picker x:Name="PickerStudents" 
                    Title="Выберите студента" 
                    ItemDisplayBinding="{Binding DisplayInfo}" />

            <!-- Поле 2: Дата и время -->
            <Label Text="Дата и время:" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*, *">
                <DatePicker Grid.Column="0" x:Name="DatePickerIncident" Format="dd.MM.yyyy" />
                <TimePicker Grid.Column="1" x:Name="TimePickerIncident" Format="HH:mm" />
            </Grid>

            <!-- Поле 3: Триггер -->
            <Label Text="Триггер паники:" FontAttributes="Bold" />
            <Picker x:Name="PickerTriggers" 
                    Title="Выберите триггер" 
                    ItemDisplayBinding="{Binding Name}" />

            <!-- Поле 4: Уровень паники -->
            <Label x:Name="LblPanicValue" Text="Уровень паники (1-10): 8" FontAttributes="Bold" />
            <Slider x:Name="SliderPanic" 
                    Minimum="1" 
                    Maximum="10" 
                    Value="8" 
                    ValueChanged="OnPanicSliderValueChanged" />

            <!-- Поле 5: Способ успокоения -->
            <Label Text="Способ успокоения:" FontAttributes="Bold" />
            <Entry x:Name="TxtCalmingMethod" 
                   Placeholder="Например: Выпил чай с ромашкой" />

            <!-- Поле 6: Помогло (Да/Нет) -->
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label x:Name="LblHelpedText" Text="Способ помог (Да):" VerticalOptions="Center" />
                <Switch x:Name="SwitchHelped" IsToggled="True" Toggled="OnHelpedToggled" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Кнопка «Сохранить» -->
            <Button Text="💾 Сохранить запись" 
                    Clicked="OnSaveClicked" 
                    HeightRequest="48" 
                    FontSize="16" 
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
