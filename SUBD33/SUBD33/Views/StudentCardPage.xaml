<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SUBD33.Views.StudentCardPage"
             Title="Карточка студента"
             BackgroundColor="#0B0F19">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="550" HorizontalOptions="Center">
            
            <HorizontalStackLayout Spacing="10">
                <Button Text="← Назад" Clicked="OnBackClicked" HeightRequest="40" BackgroundColor="#1E293B" TextColor="White" />
                <Label Text="👤 Карточка студента" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" Padding="16">
                <Grid ColumnDefinitions="160, *" ColumnSpacing="16">
                    
                    <Border Grid.Column="0" Stroke="#475569" StrokeShape="RoundRectangle 8" BackgroundColor="#0F172A" HeightRequest="160" WidthRequest="160" VerticalOptions="Start">
                        <Image x:Name="ImgPhoto" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label x:Name="LblFullName" Text="ФИО Студента" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" />
                        <Label x:Name="LblGroup" Text="Группа: ПО2311" FontSize="14" TextColor="#94A3B8" />
                        <Label x:Name="LblCourse" Text="Курс: 4" FontSize="14" TextColor="#94A3B8" />
                        
                        <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                        <Label x:Name="LblIncidentCount" Text="Количество инцидентов: 0" FontSize="14" TextColor="#38BDF8" />
                        <Label x:Name="LblAvgPanic" Text="Средний уровень паники: 0.0" FontSize="14" TextColor="#F59E0B" />
                        <Label x:Name="LblTopTrigger" Text="Самый частый триггер: —" FontSize="14" TextColor="#F43F5E" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Инциденты данного студента:" FontAttributes="Bold" FontSize="16" TextColor="#F8FAFC" Margin="0,10,0,0" />

            <CollectionView x:Name="StudentIncidentsList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Инцидентов не найдено." TextColor="#64748B" Margin="10" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#334155" StrokeShape="RoundRectangle 8" BackgroundColor="#1E293B" StrokeThickness="0.5" Padding="12,10" Margin="0,3">
                            <Grid ColumnDefinitions="130, *, 85, 75" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding DateDisplay}" TextColor="#94A3B8" VerticalOptions="Center" FontSize="12" />
                                <Label Grid.Column="1" Text="{Binding TriggerName}" TextColor="#F8FAFC" VerticalOptions="Center" FontAttributes="Bold" />
                                <Label Grid.Column="2" Text="{Binding PanicLevel, StringFormat='Паника: {0}'}" TextColor="#F59E0B" VerticalOptions="Center" FontSize="12" />
                                <Label Grid.Column="3" Text="{Binding HelpedDisplay, StringFormat='Помогло: {0}'}" TextColor="{Binding HelpedColor}" VerticalOptions="Center" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
