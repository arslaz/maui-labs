<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SUBD33.Views.QueriesPage"
             Title="Форма «Запросы»">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12">
        
        <!-- Заголовок -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="10">
            <Button Grid.Column="0" Text="← Назад" Clicked="OnBackClicked" HeightRequest="40" />
            <Label Grid.Column="1" Text="📊 Форма «Запросы» (Задание 5)" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        </Grid>

        <!-- Рабочая область -->
        <Grid Grid.Row="1" ColumnDefinitions="320, *" ColumnSpacing="16">
            
            <!-- Кнопки запросов (7 штук по условию) -->
            <ScrollView Grid.Column="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Выберите запрос:" FontAttributes="Bold" />

                    <Button x:Name="BtnQuery1" 
                            Text="1. Топ-3 триггера по инцидентам" 
                            CommandParameter="1" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery2" 
                            Text="2. Студент с макс. паникой" 
                            CommandParameter="2" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery3" 
                            Text="3. Эффективный способ успокоения" 
                            CommandParameter="3" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery4" 
                            Text="4. Инциденты с паникой 9 или 10" 
                            CommandParameter="4" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery5" 
                            Text="5. Количество инцидентов по студентам" 
                            CommandParameter="5" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery6" 
                            Text="6. Триггер с макс. паникой" 
                            CommandParameter="6" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery7" 
                            Text="7. Процент случаев когда способ помог" 
                            CommandParameter="7" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- Результаты выполнения запроса -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, *" RowSpacing="8">
                
                <!-- Название -->
                <Label Grid.Row="0" x:Name="LblCurrentQueryTitle" Text="Запрос не выбран" FontSize="16" FontAttributes="Bold" />

                <!-- SQL-текст -->
                <Border Grid.Row="1" Stroke="LightGray" Padding="8">
                    <Label x:Name="LblSqlQuery" Text="--" FontFamily="Courier" FontSize="12" />
                </Border>

                <!-- Количество строк -->
                <Label Grid.Row="2" x:Name="LblRowsCount" Text="Строк: 0" FontSize="12" TextColor="Gray" />

                <!-- Таблица результатов (DataGridView) -->
                <ScrollView Grid.Row="3" Orientation="Both">
                    <VerticalStackLayout x:Name="TableContainer" Spacing="0" />
                </ScrollView>

            </Grid>

        </Grid>

    </Grid>
</ContentPage>
