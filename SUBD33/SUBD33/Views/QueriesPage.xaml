<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SUBD33.Views.QueriesPage"
             Title="Форма «Запросы»"
             BackgroundColor="#0B0F19">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="12">
            <Button Grid.Column="0" Text="← Назад" Clicked="OnBackClicked" HeightRequest="40" BackgroundColor="#1E293B" TextColor="White" />
            <Label Grid.Column="1" Text="📊 Форма «Запросы» (Задание 5)" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="320, *" ColumnSpacing="16">
            
            <ScrollView Grid.Column="0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Выберите запрос:" FontAttributes="Bold" TextColor="#94A3B8" />

                    <Button x:Name="BtnQuery1" 
                            Text="1. Топ-3 триггера по инцидентам" 
                            CommandParameter="1" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery2" 
                            Text="2. Студент с макс. паникой" 
                            CommandParameter="2" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery3" 
                            Text="3. Эффективный способ успокоения" 
                            CommandParameter="3" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery4" 
                            Text="4. Инциденты с паникой 9 или 10" 
                            CommandParameter="4" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery5" 
                            Text="5. Инциденты по студентам" 
                            CommandParameter="5" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery6" 
                            Text="6. Триггер с макс. паникой" 
                            CommandParameter="6" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />

                    <Button x:Name="BtnQuery7" 
                            Text="7. Процент случаев когда способ помог" 
                            CommandParameter="7" 
                            Clicked="OnExecuteQueryClicked"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, *" RowSpacing="10">
                
                <Label Grid.Row="0" x:Name="LblCurrentQueryTitle" Text="Запрос не выбран" FontSize="16" FontAttributes="Bold" TextColor="#38BDF8" />

                <Border Grid.Row="1" Stroke="#334155" BackgroundColor="#0F172A" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label x:Name="LblSqlQuery" Text="--" FontFamily="Courier" FontSize="12" TextColor="#A5B4FC" />
                </Border>

                <Label Grid.Row="2" x:Name="LblRowsCount" Text="Строк: 0" FontSize="12" TextColor="#94A3B8" />

                <Border Grid.Row="3" Stroke="#334155" StrokeShape="RoundRectangle 8" BackgroundColor="#0F172A" Padding="0">
                    <ScrollView Orientation="Both">
                        <VerticalStackLayout x:Name="TableContainer" Spacing="0" />
                    </ScrollView>
                </Border>

            </Grid>

        </Grid>

    </Grid>
</ContentPage>
