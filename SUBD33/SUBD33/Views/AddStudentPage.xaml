<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SUBD33.Views.AddStudentPage"
             Title="Добавление студента"
             BackgroundColor="#0B0F19">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="500" HorizontalOptions="Center">
            
            <HorizontalStackLayout Spacing="10">
                <Button Text="← Назад" Clicked="OnBackClicked" HeightRequest="40" BackgroundColor="#1E293B" TextColor="White" />
                <Label Text="👤 Добавить студента" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="ФИО студента:" FontAttributes="Bold" TextColor="#94A3B8" />
            <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="8,0">
                <Entry x:Name="TxtFullName" Placeholder="Введите ФИО" PlaceholderColor="#64748B" TextColor="#F8FAFC" />
            </Border>

            <Label Text="Группа:" FontAttributes="Bold" TextColor="#94A3B8" />
            <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="8,0">
                <Entry x:Name="TxtGroup" Text="ПО2311" TextColor="#F8FAFC" />
            </Border>

            <Label Text="Курс (1-6):" FontAttributes="Bold" TextColor="#94A3B8" />
            <Border BackgroundColor="#1E293B" Stroke="#334155" StrokeShape="RoundRectangle 8" Padding="8,0">
                <Entry x:Name="TxtCourse" Text="4" Keyboard="Numeric" TextColor="#F8FAFC" />
            </Border>

            <Label Text="Фотография студента:" FontAttributes="Bold" TextColor="#94A3B8" />
            <HorizontalStackLayout Spacing="10">
                <Button Text="📁 Выбрать файл..." Clicked="OnPickPhotoClicked" HeightRequest="40" BackgroundColor="#6366F1" TextColor="White" />
                <Label x:Name="LblPhotoPath" Text="Файл не выбран" VerticalOptions="Center" TextColor="#64748B" FontSize="12" />
            </HorizontalStackLayout>

            <Label Text="Или выберите готовое фото из базы:" TextColor="#94A3B8" FontSize="12" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Фото 1" Clicked="OnSelectPresetPhoto" CommandParameter="student1.png" HeightRequest="32" Padding="8,0" BackgroundColor="#1E293B" TextColor="#38BDF8" FontSize="12" />
                <Button Text="Фото 2" Clicked="OnSelectPresetPhoto" CommandParameter="student2.png" HeightRequest="32" Padding="8,0" BackgroundColor="#1E293B" TextColor="#38BDF8" FontSize="12" />
                <Button Text="Фото 3" Clicked="OnSelectPresetPhoto" CommandParameter="student3.png" HeightRequest="32" Padding="8,0" BackgroundColor="#1E293B" TextColor="#38BDF8" FontSize="12" />
                <Button Text="Фото 4" Clicked="OnSelectPresetPhoto" CommandParameter="student4.png" HeightRequest="32" Padding="8,0" BackgroundColor="#1E293B" TextColor="#38BDF8" FontSize="12" />
                <Button Text="Фото 5" Clicked="OnSelectPresetPhoto" CommandParameter="student5.png" HeightRequest="32" Padding="8,0" BackgroundColor="#1E293B" TextColor="#38BDF8" FontSize="12" />
            </HorizontalStackLayout>

            <Border Stroke="#334155" StrokeShape="RoundRectangle 8" BackgroundColor="#0F172A" HeightRequest="150" WidthRequest="150" HorizontalOptions="Start">
                <Image x:Name="ImgPreview" Source="avatar_default.png" Aspect="AspectFit" />
            </Border>

            <Button Text="💾 Сохранить студента" 
                    Clicked="OnSaveClicked" 
                    HeightRequest="48" 
                    FontSize="16" 
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
