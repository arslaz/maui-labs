<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SUBD33.Models"
             x:Class="SUBD33.Views.IncidentsPage"
             Title="Просмотр записей"
             BackgroundColor="#0B0F19">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="16" RowSpacing="12">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
            <Button Grid.Column="0" Text="← Назад" Clicked="OnBackClicked" HeightRequest="40" BackgroundColor="#1E293B" TextColor="White" />
            <Label Grid.Column="1" Text="📋 Форма просмотра записей" FontSize="20" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
            
            <HorizontalStackLayout Grid.Column="2" Spacing="8">
                <Button Text="➕ Добавить" Clicked="OnAddIncidentClicked" HeightRequest="40" BackgroundColor="#10B981" TextColor="White" />
                <Button x:Name="BtnOpenCard" Text="👤 Карточка" Clicked="OnOpenCardClicked" HeightRequest="40" BackgroundColor="#6366F1" TextColor="White" />
                <Button x:Name="BtnDelete" Text="🗑️ Удалить" Clicked="OnDeleteClicked" HeightRequest="40" BackgroundColor="#EF4444" TextColor="White" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, 170, 160, Auto" ColumnSpacing="8">
            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Stroke="#334155" Padding="6,0">
                <Entry x:Name="TxtSearch" Placeholder="Поиск по ФИО, группе, триггеру..." PlaceholderColor="#64748B" TextColor="#F8FAFC" Completed="OnSearchClicked" HeightRequest="40" />
            </Border>
            
            <Button Grid.Column="1" Text="Найти" Clicked="OnSearchClicked" HeightRequest="40" BackgroundColor="#3B82F6" TextColor="White" />

            <Border Grid.Column="2" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Stroke="#334155" Padding="4,0">
                <Picker x:Name="PickerSortField" Title="Поле" TitleColor="#64748B" TextColor="#F8FAFC" SelectedIndexChanged="OnSortParameterChanged" HeightRequest="40" />
            </Border>

            <Border Grid.Column="3" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Stroke="#334155" Padding="4,0">
                <Picker x:Name="PickerSortDirection" TextColor="#F8FAFC" SelectedIndexChanged="OnSortParameterChanged" HeightRequest="40">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>По убыванию</x:String>
                            <x:String>По возрастанию</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>

            <Button Grid.Column="4" Text="Сбросить" Clicked="OnResetClicked" HeightRequest="40" BackgroundColor="#475569" TextColor="White" />
        </Grid>

        <Label Grid.Row="2" x:Name="LblRecordsCount" Text="Всего записей: 0 (двойной клик по строке открывает карточку студента)" FontSize="12" TextColor="#94A3B8" />

        <Border Grid.Row="3" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#0F172A" Padding="0">
            <Grid RowDefinitions="40, *">
                
                <Grid Grid.Row="0" BackgroundColor="#1E293B" ColumnDefinitions="45, 190, 80, 130, 150, 80, *, 80" ColumnSpacing="6" Padding="10,0">
                    <Label Grid.Column="0" Text="ID" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Студент" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="Группа" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="Дата" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="Триггер" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="5" Text="Паника" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="6" Text="Способ успокоения" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Grid.Column="7" Text="Помогло" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>

                <CollectionView Grid.Row="1" 
                                x:Name="IncidentsCollection"
                                SelectionMode="Single"
                                SelectionChanged="OnSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Incident">
                            <Border BackgroundColor="#0F172A" Stroke="#1E293B" StrokeThickness="0.5" Padding="10,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="2" 
                                                          CommandParameter="{Binding .}" 
                                                          Tapped="OnRowDoubleTapped" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="45, 190, 80, 130, 150, 80, *, 80" ColumnSpacing="6" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding Id}" TextColor="#64748B" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding StudentName}" TextColor="#F8FAFC" FontAttributes="Bold" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding GroupName}" TextColor="#94A3B8" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding DateDisplay}" TextColor="#CBD5E1" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding TriggerName}" TextColor="#E2E8F0" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="5" Text="{Binding PanicLevel, StringFormat='{0} / 10'}" TextColor="#F59E0B" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="6" Text="{Binding CalmingMethod}" TextColor="#CBD5E1" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="7" Text="{Binding HelpedDisplay}" TextColor="{Binding HelpedColor}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
